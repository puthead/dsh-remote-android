<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 方向 A「纯黑极简」：状态栏/导航栏/窗口底色必须是真黑 #000000（= DshBackground）。
         原来是 #FF101418（既不是任何 Dsh* 令牌，也会在纯黑页面顶部压出一条浅一档的横条）。 -->
    <style name="Theme.DshRemote" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">#FF000000</item>
        <item name="android:navigationBarColor">#FF000000</item>
        <item name="android:windowBackground">#FF000000</item>
    </style>
</resources>
