<?xml version="1.0" encoding="utf-8"?>
<!--
  **release 变体**：禁止明文，只允许 wss://（契约 §5.6）。

  手机在 v2 里只连中继；生产形态是中继终止 TLS，因此 release 包没有任何理由放开明文。
  debug 变体覆盖同名资源（app/src/debug/res/xml/network_security_config.xml），
  只在开发/联调时允许 ws://，并在 UI 上强制显示风险提示卡。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
